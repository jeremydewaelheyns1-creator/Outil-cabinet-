# Copier en .env pour le poste de développement. En ligne, ces valeurs viennent de
# Google Secret Manager et des variables de Cloud Run : jamais d'un fichier.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=a-remplacer-par-une-longue-chaine-aleatoire
DATABASE_URL=postgres://outil:outil@localhost:5432/outil
CABINET_NAME=Cabinet
MFA_TOTP_ISSUER=Outil cabinet

# Facultatif
# JOBS_MODE=eager
# VIES_REQUESTER_VAT=BE0123456789
# UBO_THRESHOLD_INCLUSIVE=false
# LOG_LEVEL=INFO

# Production uniquement
# DJANGO_ALLOWED_HOSTS=outil.example.be
# DJANGO_CSRF_TRUSTED_ORIGINS=https://outil.example.be
# TRUSTED_PROXY_COUNT=1
# LOG_FORMAT=json
